# Standalone snapshot in unsigned mode; NOT a linked PR/snapshot/release run.
# Native Maven-service acceptance binds image publication to source, architecture,
# digest and readiness, and rejects stable image aliases. It does not independently
# verify signature/attestation absence or scan readbacks.
# Prepare with job-image=java:<reviewed local image> and this cases file.
# Requires the contract's container/readiness runner in addition to the builder.
setting visibility=public
setting image-builder=buildah
setting admin-lint=false
setting admin-vulnerabilities=false
setting admin-application-tests=false
setting admin-reproducible-builds=false

consumer hello-maven-service published-unsigned-snapshot job-image=@JOB_IMAGE_JAVA

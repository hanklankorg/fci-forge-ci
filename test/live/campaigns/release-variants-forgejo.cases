# The release variants the demo releases of the other Forgejo lanes leave
# out, each a native signed release of a shipped demo.
#
# Two releases in a row (next-version=): the second starts from the first's
# release commit, so a stale version, lockfile or changelog shows. Every
# release is held to its commit's scope: the changelog, which names the
# version, and the version files of the bump, a lockfile with its manifest.
# Between them the lines run both changelog renderers and each version-file
# family the Forgejo releases bump: git-cliff with Go's tag-only version,
# git-chglog with Cargo.toml and Cargo.lock, with package.json and
# package-lock.json, and with pom.xml.
#
# Release images read back (release-images-config=): the declaration of the
# verified release commit is planned again and every image it names is read
# from the lab's registry with its signature, SBOM and provenance. The Go
# service's image copies the binaries the release built before it; the Cargo
# workspace's two images are tag variants of one repository. Where a planned
# Containerfile copies a file of the release's hand-off, the published
# linux/amd64 image's file is held to the released file's bytes, and to an
# artifact of the run holding them at the copied path: the Go service. The
# Cargo images compile in their Containerfile and copy none.
#
# Prepare with forgejo=<this file> and job-image= for go, java,
# javascript-typescript and rust. Buildah, on the contract's runner that
# permits user namespaces; native linux/amd64. A selector reruns one line:
#
#   just campaign-lane <dir> forgejo test/live/campaigns/release-variants-forgejo.cases
#   just campaign-lane <dir> forgejo test/live/campaigns/release-variants-forgejo.cases hello-go-cli/release

setting visibility=public
setting image-builder=buildah

consumer hello-go-cli release next-version=0.0.2 CI_JOB_IMAGE=@JOB_IMAGE_GO RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=buildah
consumer hello-cargo-container release version=0.2.0 next-version=0.2.1 CI_JOB_IMAGE=@JOB_IMAGE_RUST RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=buildah
consumer hello-npm-package release version=0.2.0 next-version=0.2.1 CI_JOB_IMAGE=@JOB_IMAGE_JAVASCRIPT_TYPESCRIPT RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=buildah
consumer hello-maven release next-version=0.0.2 CI_JOB_IMAGE=@JOB_IMAGE_JAVA RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=buildah

consumer hello-go-service release release-images-config=.forge-ci/images.yml CI_JOB_IMAGE=@JOB_IMAGE_GO RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=buildah
consumer hello-cargo-workspace release version=0.2.0 release-images-config=.forge-ci/release-images.yml CI_JOB_IMAGE=@JOB_IMAGE_RUST RELEASE_PLATFORMS=linux/amd64 CI_IMAGE_BUILDER=buildah

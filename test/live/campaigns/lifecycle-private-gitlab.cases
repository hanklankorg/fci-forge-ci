# The lifecycle of the Maven service demo in one private GitLab project under
# one pinned policy, building with kaniko: the k3s campaigns' profile, private
# and kaniko on the ordinary runner, for the linked flow lifecycle-gitlab.cases
# runs public with Buildah. The images are the GitLab release's: the runtime
# java image as job and build image (the build image is also the Java image
# the snapshot builds the service with), the signer image, the kaniko job
# image of FORGE_CI_LIVE_KANIKO_JOB_IMAGE_ARCHIVE for the snapshot's and the
# release's image builds, labelled for the project the trial serves the layer
# from as it is pushed, and the java lint image for the gate. Prepare with
# gitlab=<this file> and job-image=java:<reviewed local image>. From the
# caller, FORGE_CI_LIVE_CONSUMER_VISIBILITY=private and
# FORGE_CI_LIVE_GITLAB_IMAGE_BUILDER=kaniko, which selects the builder for the
# whole lane. Runs on either Forge Lab road. amd64 runners only for now.
#
#   just campaign-lane <dir> gitlab test/live/campaigns/lifecycle-private-gitlab.cases
setting visibility=private
setting image-builder=kaniko
setting admin-lint=false
setting admin-vulnerabilities=false
setting admin-application-tests=false
setting admin-reproducible-builds=false

consumer hello-maven-service lifecycle job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA build-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA signer-archive=@FORGE_CI_LIVE_SIGNER_IMAGE_ARCHIVE lint-archive=@LINT_IMAGE_ARCHIVE_JAVA version=0.2.0 version-bump=maven job-user=65532:65532

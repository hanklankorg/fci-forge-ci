# The lifecycle of each demo with a development route on GitLab, in one
# GitLab project each under one pinned policy: a merge request on branch
# development judged by the demo's gate, its native merge, the service
# development snapshot the policy's snapshot-images component takes on the
# merged main, then a signed release request from it. The development route
# is a service snapshot of the demo's one container from the declaration its
# release builds its images from, so the lane runs the Maven service,
# artifact-first with its runtime image, and the Cargo container,
# container-first; a demo whose declaration the snapshot cannot build, or
# that ships no GitLab release build, is refused (docs/live-campaigns.md,
# Lifecycle). The profile is the GitLab release's: the ecosystem's runtime
# image as job and build image (the build image is also the image the
# snapshot builds the Maven producer with), the signer image, the Buildah job
# image for the snapshot's and the release's image builds, and the
# ecosystem's lint image for the gate. Prepare with gitlab=<this file>,
# job-image=java:<reviewed local image> and job-image=rust:<reviewed local
# image>. amd64 runners only for now.
#
#   just campaign-lane <dir> gitlab test/live/campaigns/lifecycle-gitlab.cases
setting visibility=public
setting image-builder=buildah
setting admin-lint=false
setting admin-vulnerabilities=false
setting admin-application-tests=false
setting admin-reproducible-builds=false

consumer hello-maven-service lifecycle job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA build-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA signer-archive=@FORGE_CI_LIVE_SIGNER_IMAGE_ARCHIVE lint-archive=@LINT_IMAGE_ARCHIVE_JAVA version=0.2.0 version-bump=maven job-user=65532:65532
consumer hello-cargo-container lifecycle job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_RUST build-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_RUST signer-archive=@FORGE_CI_LIVE_SIGNER_IMAGE_ARCHIVE lint-archive=@LINT_IMAGE_ARCHIVE_RUST version=0.2.0 version-bump=cargo job-user=65532:65532

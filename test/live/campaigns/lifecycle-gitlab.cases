# The lifecycle of the Maven service demo in one GitLab project under one
# pinned policy: a merge request on branch development judged by the demo's
# gate, its native merge, the service development snapshot the policy's
# snapshot-images component takes on the merged main, then a signed release
# request from it. The profile is the GitLab release's: the runtime java
# image as job and build image (the build image is also the Java image the
# snapshot builds the service with), the signer image, the Buildah job image
# for the snapshot's and the release's image builds, and the java lint image
# for the gate. Prepare with gitlab=<this file> and job-image=java:<reviewed
# local image>. amd64 runners only for now.
#
#   just campaign-lane <dir> gitlab test/live/campaigns/lifecycle-gitlab.cases
setting visibility=public
setting image-builder=buildah
setting admin-lint=false
setting admin-vulnerabilities=false
setting admin-application-tests=false
setting admin-reproducible-builds=false

consumer hello-maven-service lifecycle job-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA build-archive=@FORGE_CI_LIVE_JOB_IMAGE_ARCHIVE_JAVA signer-archive=@FORGE_CI_LIVE_SIGNER_IMAGE_ARCHIVE lint-archive=@LINT_IMAGE_ARCHIVE_JAVA version=0.2.0 job-user=65532:65532
